# Trigenys Notify Mini App — do not commit real credentials
# Production writes intentionally disabled until Xeption schema migration is applied.
MINIAPP_ENABLED=false
MINIAPP_WRITES_ENABLED=false
# Reuse the *existing* Xeption Telegram bot; do not create another one.
TELEGRAM_BOT_TOKEN=SET_IN_HOST_SECRET_STORE
XEPTION_SUPABASE_URL=https://YOUR_XEPTION_PROJECT.supabase.co
# Supabase anon key is public; service-role key is NEVER public.
XEPTION_SUPABASE_ANON_KEY=SET_IN_HOST_CONFIGURATION
XEPTION_SUPABASE_SERVICE_ROLE_KEY=SET_IN_HOST_SECRET_STORE
XEPTION_SITE_URL=https://www.xeptionetwork.shop
PORT=3000

# Transactional email — Cloudflare Worker only; disabled until secure activation.
EMAIL_DISPATCH_ENABLED=false
EMAIL_PROJECTS_JSON={"commerce-factory":{"enabled":false,"from":"Commerce Factory <commercefactory@trigenys.com>"}}
EMAIL_COMMERCE_FACTORY_INGEST_KEY=SET_IN_CLOUDFLARE_SECRET_STORE
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
# The real parent mailbox address authenticates; an alias cannot log in independently.
SMTP_USER=SET_IN_CLOUDFLARE_SECRET_STORE
SMTP_PASSWORD=SET_IN_CLOUDFLARE_SECRET_STORE

# Trigenys Notify central provider adapter (Cloudflare Worker secrets only).
# DO NOT place the values in browser code, public-config, or commit them.
WAHA_DISPATCH_ENABLED=false
XEPTION_NOTIFY_INGEST_KEY=SET_IN_CLOUDFLARE_SECRET_STORE
WAHA_BASE_URL=https://notify.trigenys.com
WAHA_API_KEY=SET_IN_CLOUDFLARE_SECRET_STORE
WAHA_SESSION=trigenys-test
WAHA_STAFF_GROUP_ID=SET_IN_CLOUDFLARE_SECRET_STORE
# Non-secret fallback policy; never add individual project groups as secrets.
WAHA_FALLBACK_PROJECTS=xeption
WAHA_ROUTING_REQUIRED=true
# One administration key for approvals; discovery does not authorize groups.
NOTIFY_ADMIN_KEY=SET_IN_CLOUDFLARE_SECRET_STORE
WAHA_WEBHOOK_HMAC_KEY=SET_IN_CLOUDFLARE_SECRET_STORE


# Official Meta Cloud API (Atelier Maître customer templates) — NOT enabled by default.
# NEVER use WAHA for these 1:1 messages and never expose secrets in the frontend.
# Keep Atelier's existing signed Meta webhook, consent, quotas and durable outbox.
ATELIER_META_DISPATCH_ENABLED=false
ATELIER_NOTIFY_INGEST_KEY=SET_IN_CLOUDFLARE_SECRET_STORE
ATELIER_META_APPROVED_TEMPLATES=
META_CLOUD_ACCESS_TOKEN=SET_IN_CLOUDFLARE_SECRET_STORE
META_CLOUD_PHONE_NUMBER_ID=SET_IN_CLOUDFLARE_SECRET_STORE
# Choose a Meta-supported Graph API version at activation time (e.g. v25.0).
META_CLOUD_API_VERSION=
