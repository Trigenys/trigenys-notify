{
  "name": "@trigenys/trigenys-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --check web/app.js && node --test dist/test/*.test.js dist/test/core/*.test.js",
    "check": "npm run typecheck && npm test",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "waha:mock": "npm run build && node scripts/waha-smoke.mjs --mock",
    "waha:check": "npm run build && node scripts/waha-smoke.mjs --check",
    "waha:send-test": "npm run build && node scripts/waha-smoke.mjs --send"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
