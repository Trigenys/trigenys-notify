{
  "name": "@trigenys/notify-cloudflare-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run bundle:check && node scripts/routing-smoke.mjs",
    "routing:provision": "node scripts/prepare-routing.mjs",
    "typecheck": "tsc --noEmit",
    "bundle:check": "wrangler deploy --config wrangler.production.jsonc --dry-run --outdir .wrangler-dry-run",
    "dev": "wrangler dev --config wrangler.production.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@types/node": "^24.0.0",
    "miniflare": "5.20261019.1-beta",
    "typescript": "^5.8.3",
    "wrangler": "4.151.3"
  }
}
