{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trigenys-notify-staging-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MINIAPP_ENABLED": "false",
    "MINIAPP_WRITES_ENABLED": "false",
    "XEPTION_SUPABASE_URL": "https://tawnusmfyvugqczaydat.supabase.co",
    "XEPTION_MINIAPP_EDGE_URL": "https://tawnusmfyvugqczaydat.supabase.co/functions/v1/telegram-miniapp-api"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ]
}
