{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trigenys-notify-staging-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MINIAPP_ENABLED": "false",
    "MINIAPP_WRITES_ENABLED": "false"
  }
}
